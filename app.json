{
  "expo": {
    "name": "Kalanla",
    "slug": "kalanla",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#141210"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rynia.kalanla",
      "infoPlist": {
        "NSCameraUsageDescription": "KALANLA, buzdolabınızdaki yiyecekleri tespit etmek ve raf ömürlerini takip edebilmek için kameranızı kullanır.",
        "NSPhotoLibraryUsageDescription": "KALANLA, galerinizdeki buzdolabı fotoğraflarını seçerek envantere aktarabilmeniz için fotoğraflarınıza erişir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141210"
      },
      "package": "com.rynia.kalanla",
      "targetSdkVersion": 36,
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "52e7c7ee-2222-4c22-b673-d7957248e93f"
      }
    }
  }
}
